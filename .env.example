# ==============================================================================
# EMAILJS CONFIGURATION (Client-Side SMTP Email Relay)
# ==============================================================================
# Get these 3 keys from https://dashboard.emailjs.com/
#
# 1. Service ID: (From Email Services tab, e.g. "service_gmail")
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# 2. Template ID: (From Email Templates tab, e.g. "template_xxxxxxx")
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# 3. Public Key / User ID: (From Account > General > Public Key)
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Destination Email
VITE_CONTACT_RECEIVER_EMAIL=salmanvahith29@gmail.com
